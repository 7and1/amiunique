{
  "name": "@amiunique/api",
  "version": "1.0.0",
  "description": "AmiUnique.io Cloudflare Worker API with D1 database",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy src/index.ts --dry-run --outdir=dist --name=amiunique-api --compatibility-date=2024-01-01 --env=\"\"",
    "lint": "tsc --noEmit",
    "test": "vitest run --coverage",
    "db:create": "wrangler d1 create amiunique-db",
    "db:migrate": "wrangler d1 execute amiunique-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute amiunique-db --local --file=./schema.sql",
    "db:query": "wrangler d1 execute amiunique-db --command",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "4.12.32",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260727.1",
    "typescript": "^5.3.0",
    "wrangler": "4.112.0"
  }
}

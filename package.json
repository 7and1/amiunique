{
  "name": "amiunique",
  "version": "1.0.0",
  "description": "AmiUnique.io - Browser fingerprinting detection platform with 80+ dimensions",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "dev:web": "pnpm --filter @amiunique/web dev",
    "dev:api": "pnpm --filter @amiunique/api dev",
    "build:web": "pnpm --filter @amiunique/web build",
    "build:api": "pnpm --filter @amiunique/api build",
    "deploy:api": "pnpm --filter @amiunique/api run deploy -- --env production",
    "deploy:web": "pnpm --filter @amiunique/web run deploy",
    "deploy": "pnpm build && pnpm deploy:api && pnpm deploy:web",
    "db:create": "wrangler d1 create amiunique-db",
    "db:migrate": "wrangler d1 execute amiunique-db --file=./apps/api/schema.sql --config=./apps/api/wrangler.toml --remote"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [
    "fingerprinting",
    "browser",
    "privacy",
    "cloudflare",
    "workers",
    "d1"
  ],
  "author": "AmiUnique.io Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.0",
    "prettier": "^3.9.6",
    "turbo": "2.10.7",
    "typescript": "^5.3.0",
    "vite": "7.3.5",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.4.5",
      "@babel/core@<=7.29.0": "7.29.6",
      "ajv@<6.14.0": "6.14.0",
      "brace-expansion@<5.0.8": "5.0.8",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "flatted@<3.4.2": "3.4.2",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "sharp@<0.35.0": "0.35.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.18": "8.5.18",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "vite@>=7.0.0 <7.3.5": "7.3.5"
    }
  }
}
